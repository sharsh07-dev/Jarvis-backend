# JARVIS Backend Environment Variables Configuration Template
# Copy this file to .env and provide your actual credentials.

# Google Gemini API Key (Required for @google/genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Models Configuration (Defaults are pre-configured)
# Q&A Assistant model
GEMINI_MODEL=gemini-3.5-flash-lite
# Speech-to-Text audio transcription model
GEMINI_STT_MODEL=gemini-2.5-flash
# Text-to-Speech audio synthesis model
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Text-to-Speech voice name (e.g. Puck, Charon, Aoede, Fenrir, Kore)
GEMINI_TTS_VOICE=Puck

# Maximum answer character limit for 16x2 LCD display (Default: 120, Recommended: 60-120)
MAX_ANSWER_CHARS=120
# HTTP Server Port (Default: 3000)
PORT=3000

# CORS Allowed Origin (Default: * for open cross-origin development / ESP32 access)
CORS_ORIGIN=*

# Node Environment (development | production)
NODE_ENV=development

# Optional path to Firebase service account JSON key (Default: ./serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Alternatively for cloud hosts like Render: paste entire JSON string of serviceAccountKey
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

